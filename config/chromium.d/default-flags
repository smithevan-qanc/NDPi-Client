# A set of command line flags that we want to set by default.

# Do not hide any extensions in the about:extensions dialog
# export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --show-component-extension-options"

export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --default-background-color=#00000000"

# Enable GPU rasterization.
export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --enable-gpu-rasterization"

# Don't display any warnings about not being the default browser
export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --no-default-browser-check"

# Disable pinging
export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --disable-pings"

# Disable the builtin media router (bug #833477)
export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --media-router=0"

export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --aggressive-cache-discard"
export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --disable-popup-blocking"
export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --hide-crash-restore-bubble"
export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --disable-infobars"
export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --disable-session-crashed-bubble"
export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --disable-component-extensions-with-background-pages"
export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --no-first-run"
export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --disable-default-apps"
export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --disable-translate"
export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --hide-scrollbars"
export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --disable-features=TranslateUI"
export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --noerrdialogs"
export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --touch-events=enabled"