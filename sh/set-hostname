#!/usr/bin/env bash
set -e

if [ "$OPERATION_STATUS" == "BUILD" ]; then
    echo "OPERATION_STATUS set to 'BUILD'"
    echo "Skipping Hostname Configuration"
    exit 0
fi

CURRENT_HOSTNAME="$(hostname)"
NEW_HOSTNAME="$1"

if [ "$NEW_HOSTNAME" == "" ]; then
    echo "New hostname must be provided"
    echo "Usage: $0 <New Hostname>"
    exit 1
fi

echo "Current Hostname:   ${CURRENT_HOSTNAME}"
echo "Requested Hostname: ${NEW_HOSTNAME}"

if [ "$CURRENT_HOSTNAME" == "$NEW_HOSTNAME" ]; then
    exit 0
fi

echo "Setting Device Hostname to: ${NEW_HOSTNAME}"

# 1. Update the kernel and configuration files
sudo hostnamectl set-hostname "$NEW_HOSTNAME"
sudo sed -i "s/127.0.1.1.*/127.0.1.1\t$NEW_HOSTNAME/g" /etc/hosts

# 2. Identify the active network interface connected to the router
INTERFACE=$(ip route | grep default | awk '{print $5}' | head -n1)

# 3. Force the DHCP client to push the new name to the router
if command -v nmcli >/dev/null 2>&1; then
    # For NetworkManager systems (Ubuntu, Debian, Fedora, RHEL)
    sudo nmcli connection modify "$INTERFACE" ipv4.dhcp-hostname "$NEW_HOSTNAME"
    sudo nmcli connection up "$INTERFACE"
elif command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet systemd-networkd; then
    # For systemd-networkd systems
    sudo systemctl restart systemd-networkd
else
    # Fallback for traditional dhclient
    sudo dhclient -r "$INTERFACE" && dhclient "$INTERFACE"
fi

# 4. Broadcast the change to other local machines on the router
if systemctl list-unit-files | grep -q avahi-daemon; then
    sudo systemctl restart avahi-daemon
fi

echo "Hostname updated to $NEW_HOSTNAME."