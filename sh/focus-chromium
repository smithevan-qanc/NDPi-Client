fadeIn() {
    local current=$(amixer sget PCM | awk '/Front Left:/ {print $4; exit}')
    local target=100

    if [ "$current" -lt "$target" ]; then
        while [ "$current" -lt "$target" ]; do
            current=$((current + 1))
            [ "$current" -gt "$target" ] && current=$target
            # amixer set PCM "${current}%" >/dev/null
            picom-trans -w $WINDOW_ID $current >/dev/null
            sleep $FADE_TIME
        done
    else
        while [ "$current" -gt "$target" ]; do
            current=$((current - 1))
            [ "$current" -lt "$target" ] && current=$target
            # amixer set PCM "${current}%" >/dev/null
            picom-trans -w $WINDOW_ID $current >/dev/null
            sleep $FADE_TIME
        done
    fi
}
fadeOut() {
    local current=$(amixer sget PCM | awk '/Front Left:/ {print $4; exit}')
    local target=0

    if [ "$current" -lt "$target" ]; then
        while [ "$current" -lt "$target" ]; do
            current=$((current + 1))
            [ "$current" -gt "$target" ] && current=$target
            amixer set PCM "${current}%" >/dev/null
            # picom-trans -w $WINDOW_ID $current >/dev/null
            sleep $FADE_TIME
        done
    else
        while [ "$current" -gt "$target" ]; do
            current=$((current - 1))
            [ "$current" -lt "$target" ] && current=$target
            amixer set PCM "${current}%" >/dev/null
            # picom-trans -w $WINDOW_ID $current >/dev/null
            sleep $FADE_TIME
        done
    fi
}

# Start
activateWindow
fadeIn
fadeOut
