#!/usr/bin/env bash

# Reports per-port display/resolution state for both of the Client's HDMI
# outputs. Both real outputs are mirrored on a single DISPLAY=:0 session
# (see functions.js's setDisplayResolution()) -- so one `xrandr` call
# already reports both connectors, each in its own block of output.
#
# Every line is emitted as "<key> : <PORT> :: <value>" (list_resolutions'
# own value additionally embeds a second ' :: ' separating a human-readable
# label from the raw mode string) -- client_fs.js's updateOutputDisplayFiles()
# parses this tagged format directly into each port's own
# output_display_hdmi1_*/output_display_hdmi2_* keys.

export DISPLAY=:0

XRANDR_OUTPUT="$(xrandr)"

echo "$XRANDR_OUTPUT" | awk '
    /^[^ ]/ {
        port = "";
        if ($0 ~ / connected/) {
            port = $1;
            print "current_output : " port " :: " port;
        }
        next;
    }
    port != "" && /^[ \t]/ {
        mode = $1;
        print "list_resolutions : " port " :: " mode " " $2 " :: " mode;
        for (i = 2; i <= NF; i++) {
            if ($i ~ /\*/) {
                rate = $i; gsub(/[*+]/, "", rate);
                print "current_resolution : " port " :: " mode;
                print "current_framerate : " port " :: " rate;
            }
            if ($i ~ /\+/) {
                rate = $i; gsub(/[*+]/, "", rate);
                print "preferred_resolution : " port " :: " mode;
                print "preferred_framerate : " port " :: " rate;
            }
        }
    }
'

# Allowed framerates for the *currently active* mode on each port (mirrors
# the original single-port behavior: every listed rate for whichever mode
# is marked current "*").
for PORT_LINE in $(echo "$XRANDR_OUTPUT" | grep -Fw 'connected' | awk '{print $1}'); do
    RESOLUTION_CURR="$(echo "$XRANDR_OUTPUT" | awk -v p="$PORT_LINE" '
        $0 ~ "^"p" " { active=1; next }
        /^[^ ]/ { active=0 }
        active && /^[ \t]/ && /\*/ { print $1; exit }
    ')"
    if [[ -n "$RESOLUTION_CURR" ]]; then
        RATES="$(echo "$XRANDR_OUTPUT" | awk -v p="$PORT_LINE" -v m="$RESOLUTION_CURR" '
            $0 ~ "^"p" " { active=1; next }
            /^[^ ]/ { active=0 }
            active && /^[ \t]/ && $1 == m {
                for (i=2;i<=NF;i++) { gsub(/[*+]/,"",$i); printf "%s ", $i }
            }
        ')"
        echo "allowed_framerates : $PORT_LINE :: $RATES"
    fi
done

# EDID (per physical connector -- card1-HDMI-A-1 = HDMI-1, card1-HDMI-A-2 = HDMI-2)
for entry in "HDMI-1:card1-HDMI-A-1" "HDMI-2:card1-HDMI-A-2"; do
    PORT="${entry%%:*}"
    CARD="${entry##*:}"

    echo "$(edid-decode /sys/class/drm/${CARD}/edid | \
        grep -wF 'Manufacturer:' | tr -d "'" | \
        awk -F ':' -v p="$PORT" '{gsub(/^ +| +$/, "", $2); print "manufacturer : " p " :: " $2}')"

    echo "$(edid-decode /sys/class/drm/${CARD}/edid | \
        grep -wF 'Display Product Name:' | tr -d "'" | \
        awk -F ':' -v p="$PORT" '{gsub(/^ +| +$/, "", $2); print "model_name : " p " :: " $2}')"

    echo "$(edid-decode /sys/class/drm/${CARD}/edid | \
        grep -wF 'Model:' | tr -d "'" | \
        awk -F ':' -v p="$PORT" '{gsub(/^ +| +$/, "", $2); print "model_number : " p " :: " $2}')"

    echo "$(edid-decode /sys/class/drm/${CARD}/edid | \
        grep -wF 'Display Product Serial Number:' | tr -d "'" | \
        awk -F ':' -v p="$PORT" '{gsub(/^ +| +$/, "", $2); print "sn : " p " :: " $2}')"
done

exit 0
