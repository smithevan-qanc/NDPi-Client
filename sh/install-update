#!/bin/bash
set -e

# This script is executed on the remote machine automatically after the update from GitHub is downloaded.
# Write the script (if any is required) inside the install() function below.

# NOTE:
#   The contents of this file will RESET automatically after running 'updateGit.sh'.

install() {
    # Write Update Script Here
    echo "INSTALLING UPDATE"
    sleep 1
    cd /home/ndpi-client
    sudo rsync -zq ndpi/config/pcmanfm/desktop-items-0.conf /home/ndpi-client/.config/pcmanfm/default/
    sudo rsync -zq ndpi/config/openbox/autostart /home/ndpi-client/.config/openbox/
    sudo chown ndpi-client:ndpi-client /home/ndpi-client/.config/openbox/autostart
    sudo rsync -zq ndpi/config/chromium.d/default-flags /etc/chromium.d/
    sleep 1
    sudo systemctl stop ndpi.service
    sleep 2
    sudo reboot
    # sudo reboot
}
install

echo "INSTALLATION COMPLETE"