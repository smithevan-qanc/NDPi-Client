fadeInVolume() {
    current=$(amixer sget PCM | awk '/Front Left:/ {print $4; exit}')
    target=255

    if [ "$current" -lt "$target" ]; then
        while [ "$current" -lt "$target" ]; do
            current=$((current + 5))
            [ "$current" -gt "$target" ] && current=$target
            amixer set PCM "$current" >/dev/null
            sleep $FADE_TIME
        done
    else
        while [ "$current" -gt "$target" ]; do
            current=$((current - 5))
            [ "$current" -lt "$target" ] && current=$target
            amixer set PCM "$current" >/dev/null
            sleep $FADE_TIME
        done
    fi
}
fadeOutVolume() {
    current=$(amixer sget PCM | awk '/Front Left:/ {print $4; exit}')
    target=0

    if [ "$current" -lt "$target" ]; then
        while [ "$current" -lt "$target" ]; do
            current=$((current + 5))
            [ "$current" -gt "$target" ] && current=$target
            amixer set PCM "$current" >/dev/null
            sleep $FADE_TIME
        done
    else
        while [ "$current" -gt "$target" ]; do
            current=$((current - 5))
            [ "$current" -lt "$target" ] && current=$target
            amixer set PCM "$current" >/dev/null
            sleep $FADE_TIME
        done
    fi
}

activateWindow() {
    WINDOW_ID="$(xdotool search --class 'gstreamer' | head -n 1)"

    if [[ -z "$WINDOW_ID" ]]; then
        echo "$1 FAILED to find visible window."
        echo "---------"
        echo "[Results]"
        echo "$(xdotool search --class 'gstreamer')"
        echo "---------"
        exit 1
    fi

    xdotool windowminimize $WINDOW_ID
    sleep 0.5

    xdotool windowraise $WINDOW_ID
    sleep 0.5

    xdotool windowactivate $WINDOW_ID
}

# Start
activateWindow

fadeInVolume

if ! [[ -z "$(pgrep picom)" ]]; then
    killall picom >/dev/null 2>&1
fi

exit 0