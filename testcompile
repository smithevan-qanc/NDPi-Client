        set -e

        cd ${REMOTE_DIR_PGM}/ndi_receiver_v3__NDI6
        echo ""
        echo "Removing Old Receiver"
        sudo rm DEV_ndi_receiver_v4
    "; then
        echo 'Good'
    else
        echo 'No Bueno'
    fi

    if ssh "${SSH_LOGIN}" "
        set -e
        
        echo ""
        echo "Compiling Receiver"
        cd ${REMOTE_DIR_PGM}/sh
        sudo ./compile-receiver
        sleep 1

        echo ""
        echo "Moving Into Final Destination"
        cd ${REMOTE_DIR_PGM}
        sudo mv DEV_ndi_receiver_v4 ./ndi_receiver_v3__NDI6
        sleep 1

        cd ${REMOTE_DIR_PGM}/ndi_receiver_v3__NDI6
        ./DEV_ndi_receiver_v4 -v
    "; then
        echo 'Good'
    else
        echo 'No Bueno'
    fi
}
